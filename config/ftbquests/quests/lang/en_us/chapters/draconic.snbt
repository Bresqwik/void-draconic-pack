	quest.3AA03229E032A827.title: "Draconium-Kern"
	quest.47EDFD68EDA86860.quest_desc: [
		"Die höchste Stufe. Chaotische Werkzeuge und Rüstung sind das Ende der Fahnenstange."
	]
	quest.47EDFD68EDA86860.title: "Chaotischer Kern"
	quest.5599DF0C99472E86.quest_desc: [
		"Ein Multiblock-Akku, der in höheren Stufen Billionen FE speichert. Die Pylonen verbinden ihn mit deinem Netz."
	]
	quest.5599DF0C99472E86.title: "Der Energiekern"
	quest.6B4812F4EEAF1EC2.quest_desc: [
		"Der Fusions-Kern in der Mitte, Injektoren drumherum (mit Blick auf den Kern). Jeder Injektor hält eine Zutat, der Kern das Hauptitem. Strom rein und los."
	]
	quest.6B4812F4EEAF1EC2.title: "Fusion Crafting"
	quest.70253749A0B0F8DD.quest_desc: [
		"Fliegen, Schilde, Module. Mit dem Modul-System baust du sie nach deinen Wünschen aus."
	]
	quest.70253749A0B0F8DD.title: "Draconic-Rüstung"
	quest.742272843F315D14.quest_desc: [
		"Auf der Chaos-Insel weit draußen im End wartet der &4Chaos-Wächter&r. Nur mit sehr guter Ausrüstung angehen! Er lässt &4Chaos-Splitter&r fallen."
	]
	quest.742272843F315D14.title: "Der Chaos-Wächter"
	quest.7E5F5E159F0C9B3E.quest_desc: [
		"Mit dem Drachenherz erweckst du Draconium. Daraus wird die Draconic-Stufe."
