{
	quest.042A463073351EC7.quest_desc: [
		"Der erste große Fusionsschritt. Mit Wyvern-Injektoren wird Fusion schneller."
	]
	quest.042A463073351EC7.title: "Wyvern-Kern"
	quest.13C599919364C0CE.quest_desc: [
		"&5Draconium&r findest du tief unten, im Nether und im End (dort am meisten). Mit dem Erz-Programm liefert es auch der Void Miner."
