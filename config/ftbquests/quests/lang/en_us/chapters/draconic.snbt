	quest.7E5F5E159F0C9B3E.title: "Erwachtes Draconium"
	quest.9B3DBD937A35E016.quest_desc: [
		"Unvorstellbar viel Strom, aber Vorsicht: ein schlecht eingestellter Reaktor explodiert und reißt einen riesigen Krater. Erst in einer Testwelt üben!"
	]
	quest.9B3DBD937A35E016.title: "&c&lDer Draconic-Reaktor"
