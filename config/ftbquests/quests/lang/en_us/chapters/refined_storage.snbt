{
	quest.064F01C27DF28D22.quest_desc: [
		"Herz des Netzes. Er braucht Strom (FE), alles andere wird per &eKabel&r angeschlossen. Anders als bei AE2 gibt es &akeine Kanäle&r."
	]
	quest.064F01C27DF28D22.title: "Der Controller"
	quest.371AC4A32451815A.quest_desc: [
		"Das Crafting Grid zeigt alles im Netz und hat eine Werkbank eingebaut. Mit &eJEI&r überträgst du Rezepte direkt hinein."
	]
	quest.371AC4A32451815A.title: "Zugriff"
	quest.5D5046F8855F211B.quest_desc: [
		"Im Pattern Grid legst du Muster an, der &eCrafter&r stellt sie dann auf Bestellung her. Auch Maschinenrezepte (Verarbeitungsmuster) gehen."
	]
	quest.5D5046F8855F211B.title: "Autocrafting"
	quest.74EE54B5A32D5F9D.quest_desc: [
		"&eExtraStorage&r bringt riesige Disks und schnellere Crafter."
	]
	quest.74EE54B5A32D5F9D.title: "Mehr Platz"
	quest.82FF4139C36D296A.quest_desc: [
		"Mit dem Wireless Transmitter erreichst du dein Lager von überall. Das &eUniversal Grid&r schaltet zwischen Grid, Crafting Grid und Autocrafting-Monitor um."
	]
	quest.82FF4139C36D296A.title: "Kabellos"
	quest.859D47BEDB8F92EE.quest_desc: [
		"Importer ziehen Items aus Maschinen ins Netz, Exporter schieben sie hinein. So fütterst du z. B. die Mekanism-Erzverarbeitung."
	]
	quest.859D47BEDB8F92EE.title: "Rein und raus"
	quest.A3E91C3A66DF01DE.quest_desc: [
		"Prozessoren stecken in fast allen Bauteilen."
	]
	quest.A3E91C3A66DF01DE.title: "Prozessoren"
	quest.DCB0C815CA81332F.quest_desc: [
		"Die Grundzutaten von Refined Storage: Eisen mit Netherquarz und &eSilizium&r aus geschmolzenem Quarz."
	]
	quest.DCB0C815CA81332F.title: "Quarzangereichertes Eisen"
	quest.EA54161227BCD715.quest_desc: [
		"Das Laufwerk nimmt bis zu 8 Disks auf. Eine 1k-Disk fasst 1.000 Items beliebiger Sorten."
	]
	quest.EA54161227BCD715.title: "Erster Speicher"
	quest.FE51B76A3B2598B9.quest_desc: [
		"&eCable Tiers&r macht Importer und Exporter schneller und gibt ihnen mehr Filterplätze."
	]
	quest.FE51B76A3B2598B9.title: "Schnellere Busse"
}
