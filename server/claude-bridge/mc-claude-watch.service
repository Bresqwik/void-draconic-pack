[Unit]
Description=Void & Draconic – Server-Wächter (Claude): Überwachung, Auto-Maßnahmen, private Meldungen
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mc-claude
ExecStart=/usr/bin/python3 /opt/mc-claude/watch.py
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
