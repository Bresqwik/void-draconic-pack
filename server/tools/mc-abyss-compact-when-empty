#!/usr/bin/env bash
# Verkleinert die Abyss-Biomtabelle in der level.dat (verlustfrei, siehe abyss-leveldat-compact.py).
# Geht nur bei gestopptem Server, weil der Server die level.dat sonst beim nächsten Autosave aus dem Speicher überschreibt.
# Wartet, bis 60 s lang niemand online ist und kein Backup läuft. Einmalig per systemd-run starten.
L=/var/www/mc-dashboard/data/live.json
W=/opt/void-draconic/world
empty=0
while true; do
  if python3 -c "import json,sys; d=json.load(open(\"$L\")); a=d.get(\"backup\",{}).get(\"active\",[]); sys.exit(0 if d.get(\"online\") and d[\"players\"][\"online\"]==0 and not any(x.get(\"phase\")==\"erstellen\" for x in a) else 1)"; then
    empty=$((empty+5)); [ $empty -ge 60 ] && break
  else
    empty=0
  fi
  sleep 5
done
echo "Niemand online: Server stoppen, level.dat verkleinern, starten."
systemctl stop void-draconic
cp -a "$W/level.dat" "/opt/archiv/level.dat.vor-abyss-compact-$(date +%Y%m%d-%H%M)"
sudo -u minecraft python3 -I /usr/local/lib/abyss-leveldat-compact.py "$W/level.dat" --roundtrip-test --write
systemctl start void-draconic
