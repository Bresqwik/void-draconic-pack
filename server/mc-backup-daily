#!/usr/bin/env bash
# Täglich (mc-backup-cloud.timer, 04:00): frisches Backup anlegen – auch wenn niemand online ist –,
# (mc-backup-now: warten, bis die ZIP fertig geschrieben ist), dann alle fertigen Backups nach Google Drive hochladen, prüfen und lokal löschen.
set -uo pipefail
DIR=/opt/void-draconic/simplebackups
newest() { (find "$DIR" -type f -name '*.zip' -printf '%T@ %p\n' 2>/dev/null || true) | sort -n | tail -1 | cut -d' ' -f2-; }

# Gibt es schon ein Backup der letzten 6 Stunden (z. B. manuell oder SimpleBackups-Notnagel), kein zweites anlegen.
/usr/local/bin/mc-backup-now --if-older 360 || echo "Kein neues Backup – lade das letzte vorhandene hoch."
exec /usr/local/bin/mc-backup-cloud --wait
