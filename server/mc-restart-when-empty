#!/usr/bin/env bash
# Startet den Server neu (z. B. für ein Pack-Update), sobald 60 s lang niemand online ist und kein Backup geschrieben wird.
#   mc-restart-when-empty         neu starten
#   mc-restart-when-empty stop    nur stoppen (Knopf „Stoppen, sobald leer“ im Dashboard)
ACTION=restart
[ "${1:-}" = "stop" ] && ACTION=stop
L=/var/www/mc-dashboard/data/live.json
empty=0
while true; do
  if python3 -c "import json,sys; d=json.load(open(\"$L\")); a=d.get(\"backup\",{}).get(\"active\",[]); sys.exit(0 if d.get(\"online\") and d[\"players\"][\"online\"]==0 and not any(x.get(\"phase\")==\"erstellen\" for x in a) else 1)"; then
    empty=$((empty+5)); [ $empty -ge 60 ] && break
  else
    empty=0
  fi
  sleep 5
done
if [ "$ACTION" = stop ]; then
  echo "Niemand online, stoppe den Server."
else
  echo "Niemand online, starte den Server neu (Pack-Update)."
fi
systemctl $ACTION void-draconic
