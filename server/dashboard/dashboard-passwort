#!/usr/bin/env bash
# Legt Benutzer und Passwort fuer das gemeinsame Crew-Konto des Dashboards fest. Gespeichert wird nur der Hash
# (/etc/caddy/dashboard.env). Admin-Konten (gesetzt mit "dashboard-admin") bleiben erhalten.
set -e
F=/etc/caddy/dashboard.env
read -rp "Benutzername [void]: " U; U=${U:-void}
[[ $U =~ ^[A-Za-z0-9._-]+$ ]] || { echo "Nur Buchstaben, Ziffern, Punkt, Strich, Unterstrich."; exit 1; }
read -rsp "Passwort: " P1; echo
read -rsp "Passwort wiederholen: " P2; echo
[ "$P1" = "$P2" ] || { echo "Passwoerter stimmen nicht ueberein."; exit 1; }
[ ${#P1} -ge 8 ] || { echo "Bitte mindestens 8 Zeichen."; exit 1; }
H=$(printf "%s\n" "$P1" | caddy hash-password); unset P1 P2
{ printf "DASH_USER=%s\nDASH_HASH=%s\n" "$U" "$H"; grep -E "^ADMIN(_USER=|_HASH=|:)" "$F" 2>/dev/null || true; } > "$F.tmp"
chmod 640 "$F.tmp"; chgrp caddy "$F.tmp"; mv "$F.tmp" "$F"
echo "Gespeichert. Login: $U – https://mc-void-draconic.duckdns.org"
